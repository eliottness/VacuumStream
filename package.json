{
  "name": "vacuumstream",
  "version": "0.1.0",
  "description": "A controller-first Twitch client for Linux HTPCs",
  "author": {
    "name": "Eliott Bouhana",
    "url": "https://github.com/eliottness"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/eliottness/VacuumStream",
  "repository": {
    "type": "git",
    "url": "https://github.com/eliottness/VacuumStream.git"
  },
  "bugs": {
    "url": "https://github.com/eliottness/VacuumStream/issues"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.16.0"
  },
  "desktopName": "io.github.eliottness.VacuumStream.desktop",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build",
    "pack": "bun run build && electron-builder --dir --publish never",
    "package:appimage": "bun run build && electron-builder --linux AppImage --x64 --publish never",
    "package:flatpak": "bash scripts/build-flatpak.sh",
    "package:release": "bash scripts/build-release.sh"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "ky": "2.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "42.11.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "build": {
    "afterPack": "./scripts/after-pack.cjs",
    "appId": "io.github.eliottness.VacuumStream",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "productName": "VacuumStream",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/certs",
        "to": "certs"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo;Video",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "synopsis": "Controller-first Twitch viewing for Linux TVs and handhelds",
      "desktop": {
        "entry": {
          "Name": "VacuumStream",
          "Comment": "Browse and watch Twitch with a controller",
          "Categories": "AudioVideo;Video;",
          "Keywords": "Twitch;streaming;HTPC;Steam Deck;"
        }
      }
    },
    "appImage": {
      "compression": "zstd"
    }
  }
}
